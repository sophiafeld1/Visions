{
  "name": "visions-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "db:setup": "node server/setup-db.js",
    "db:update": "node server/update-inventory.js",
    "vercel": "vercel",
    "deploy": "vercel --prod",
    "sitemap": "node scripts/generate-sitemap.js",
    "inventory:seed": "node scripts/seed-inventory.js",
    "inventory:sync-test": "node scripts/sync-test-inventory.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "test:inventory": "node --test --test-concurrency=1 tests/inventory-store.test.js tests/checkout-inventory.test.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "stripe": "^17.7.0"
  }
}
