{
  "name": "visions-shop",
  "headers": [
    {
      "source": "/data/products.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[^&]+)"
        }
      ],
      "destination": "/product/:id.html",
      "permanent": true
    }
  ]
}
